{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Defender",
          "informationUri": "https://defender.local",
          "version": "0.1.0",
          "rules": [
            {
              "id": "SEC-HARDCODED-SECRET",
              "name": "Hardcoded secret / credential",
              "shortDescription": {
                "text": "Hardcoded secret / credential"
              },
              "properties": {
                "dimension": "security",
                "frameworks": [
                  "OWASP A07",
                  "CWE-798",
                  "PCI-DSS 8.2.1"
                ]
              }
            },
            {
              "id": "SEC-TLS-DISABLED",
              "name": "TLS certificate verification disabled",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "properties": {
                "dimension": "security",
                "frameworks": [
                  "OWASP A02",
                  "CWE-295",
                  "PCI-DSS 4.1"
                ]
              }
            },
            {
              "id": "AI-SECURITY-BA3098",
              "name": "TLS verification disabled",
              "shortDescription": {
                "text": "TLS verification disabled"
              },
              "properties": {
                "dimension": "security",
                "frameworks": []
              }
            },
            {
              "id": "PCI-PAN-VARIABLE",
              "name": "Cardholder data variable in scope",
              "shortDescription": {
                "text": "Cardholder data variable in scope"
              },
              "properties": {
                "dimension": "compliance",
                "frameworks": [
                  "PCI-DSS 3.4",
                  "PCI-DSS 4.1"
                ]
              }
            },
            {
              "id": "GDPR-PII-LOGGING",
              "name": "Potential PII written to logs",
              "shortDescription": {
                "text": "Potential PII written to logs"
              },
              "properties": {
                "dimension": "compliance",
                "frameworks": [
                  "GDPR Art.5",
                  "GDPR Art.32",
                  "SOC 2 CC6.1"
                ]
              }
            },
            {
              "id": "AI-COMPLIANCE-59E0EC",
              "name": "Possible PAN handling \u2014 PCI-DSS scope",
              "shortDescription": {
                "text": "Possible PAN handling \u2014 PCI-DSS scope"
              },
              "properties": {
                "dimension": "compliance",
                "frameworks": []
              }
            },
            {
              "id": "PERF-SELECT-STAR",
              "name": "SELECT * query",
              "shortDescription": {
                "text": "SELECT * query"
              },
              "properties": {
                "dimension": "performance",
                "frameworks": []
              }
            },
            {
              "id": "AI-PERFORMANCE-65263C",
              "name": "SELECT * pulls unneeded columns",
              "shortDescription": {
                "text": "SELECT * pulls unneeded columns"
              },
              "properties": {
                "dimension": "performance",
                "frameworks": []
              }
            },
            {
              "id": "VULN-REQUESTS-NO-TIMEOUT",
              "name": "Outbound HTTP call without timeout",
              "shortDescription": {
                "text": "Outbound HTTP call without timeout"
              },
              "properties": {
                "dimension": "vulnerability",
                "frameworks": [
                  "CWE-400"
                ]
              }
            },
            {
              "id": "VULN-HTTP-URL",
              "name": "Cleartext HTTP endpoint",
              "shortDescription": {
                "text": "Cleartext HTTP endpoint"
              },
              "properties": {
                "dimension": "vulnerability",
                "frameworks": [
                  "CWE-319",
                  "PCI-DSS 4.1"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SEC-HARDCODED-SECRET",
          "level": "error",
          "message": {
            "text": "A secret, API key, or password appears to be hardcoded in source."
          },
          "properties": {
            "severity": "critical",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-TLS-DISABLED",
          "level": "error",
          "message": {
            "text": "verify=False / rejectUnauthorized:false disables TLS validation."
          },
          "properties": {
            "severity": "high",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 11
                }
              }
            }
          ]
        },
        {
          "ruleId": "AI-SECURITY-BA3098",
          "level": "error",
          "message": {
            "text": "The security analyzer (offline mock) flagged a pattern resembling 'verify=false'. Review whether this is appropriate for a regulated banking workload."
          },
          "properties": {
            "severity": "high",
            "source": "agent"
          }
        },
        {
          "ruleId": "PCI-PAN-VARIABLE",
          "level": "error",
          "message": {
            "text": "Variable names suggest cardholder data flows through this code."
          },
          "properties": {
            "severity": "high",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ]
        },
        {
          "ruleId": "GDPR-PII-LOGGING",
          "level": "error",
          "message": {
            "text": "Logging call appears to include PII (email, ssn, dob, name)."
          },
          "properties": {
            "severity": "high",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ]
        },
        {
          "ruleId": "AI-COMPLIANCE-59E0EC",
          "level": "error",
          "message": {
            "text": "The compliance analyzer (offline mock) flagged a pattern resembling 'card_number'. Review whether this is appropriate for a regulated banking workload."
          },
          "properties": {
            "severity": "high",
            "source": "agent"
          }
        },
        {
          "ruleId": "PERF-SELECT-STAR",
          "level": "warning",
          "message": {
            "text": "SELECT * fetches unnecessary columns and defeats indexing."
          },
          "properties": {
            "severity": "medium",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ]
        },
        {
          "ruleId": "AI-PERFORMANCE-65263C",
          "level": "warning",
          "message": {
            "text": "The performance analyzer (offline mock) flagged a pattern resembling 'select *'. Review whether this is appropriate for a regulated banking workload."
          },
          "properties": {
            "severity": "medium",
            "source": "agent"
          }
        },
        {
          "ruleId": "VULN-REQUESTS-NO-TIMEOUT",
          "level": "warning",
          "message": {
            "text": "requests call without a timeout can hang worker threads (DoS)."
          },
          "properties": {
            "severity": "medium",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 11
                }
              }
            }
          ]
        },
        {
          "ruleId": "VULN-HTTP-URL",
          "level": "warning",
          "message": {
            "text": "An http:// URL transmits data without encryption."
          },
          "properties": {
            "severity": "medium",
            "source": "static"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "service/transfer.py"
                },
                "region": {
                  "startLine": 11
                }
              }
            }
          ]
        }
      ]
    }
  ]
}